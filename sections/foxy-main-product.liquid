<section class="foxy-pdp color-scheme-background" id="FoxyProduct-{{ section.id }}" data-section="{{ section.id }}" data-product-id="{{ product.id }}">
  {{ 'foxy-pdp.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'foxy-pdp.js' | asset_url }}" defer></script>

  <div class="foxy-pdp__container">
    <!-- MEDIA CAROUSEL (LEFT) -->
    <div class="foxy-pdp__media">
      {%- assign media_count = product.media.size -%}
      {%- if media_count > 0 -%}
        <div class="foxy-pdp__carousel">
          {%- for media in product.media -%}
            <div class="foxy-pdp__slide" data-index="{{ forloop.index0 }}">
              {%- if media.media_type == 'image' -%}
                {{ media | image_url: width: 1400 | image_tag: loading: 'lazy', alt: media.alt | escape }}
              {%- else -%}
                {{ media | media_tag }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        
        {%- if media_count > 1 -%}
          <div class="foxy-pdp__deck-indicators">
            {%- for media in product.media -%}
              <div class="foxy-pdp__deck-indicator{% if forloop.first %} active{% endif %}"></div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <!-- Fallback if no media -->
        <div class="foxy-pdp__carousel">
          <div class="foxy-pdp__slide">
             {{ 'product-1' | placeholder_svg_tag }}
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- PRODUCT INFO OVERLAY (RIGHT) -->
    <div class="foxy-pdp__info">
      {%- assign product_form_id = 'product-form-' | append: section.id -%}
      
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
            
          {%- when 'vendor' -%}
            <div class="foxy-pdp__vendor" {{ block.shopify_attributes }}>
              {{ product.vendor }}
            </div>
            
          {%- when 'title' -%}
            <h1 class="foxy-pdp__title" {{ block.shopify_attributes }}>
              {{ product.title | escape }}
            </h1>
            
          {%- when 'price' -%}
             <div class="foxy-pdp__price" {{ block.shopify_attributes }}>
              {%- render 'price', product: product, use_variant: true, price_class: 'price--large' -%}
            </div>
            
          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="foxy-pdp__description rte" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {%- endif -%}
            
          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="foxy-pdp__variants" {{ block.shopify_attributes }}>
                <label class="foxy-pdp__variant-label">Select Variant</label>
                <select class="foxy-pdp__variant-select" name="id" form="{{ product_form_id }}">
                  {%- for variant in product.variants -%}
                    {%- assign slide_idx = 0 -%}
                    {%- if variant.featured_media -%}
                      {%- for media in product.media -%}
                        {%- if media.id == variant.featured_media.id -%}
                          {%- assign slide_idx = forloop.index0 -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                    
                    <option value="{{ variant.id }}" 
                      {% if variant == product.selected_or_first_available_variant %}selected="selected"{% endif %}
                      {% if variant.available == false %}disabled{% endif %}
                      data-slide-index="{{ slide_idx }}"
                      data-price="{{ variant.price | money | escape }}">
                      {{ variant.title }} - {{ variant.price | money }}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endunless -%}
            
          {%- when 'buy_buttons' -%}
             <div class="foxy-pdp__form" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <div class="foxy-pdp__quantity-row">
                    <div class="foxy-pdp__qty-wrapper">
                      <button type="button" class="foxy-pdp__qty-btn" aria-label="Decrease quantity" onclick="this.nextElementSibling.stepDown()">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                      </button>
                      <input type="number" name="quantity" value="1" min="1" form="{{ product_form_id }}" class="foxy-pdp__qty-input" aria-label="Product quantity">
                      <button type="button" class="foxy-pdp__qty-btn" aria-label="Increase quantity" onclick="this.previousElementSibling.stepUp()">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                      </button>
                    </div>
                    <button type="submit" name="add" class="foxy-pdp__btn foxy-pdp__btn--add" {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}>
                      {%- if product.selected_or_first_available_variant.available -%}
                        {{ 'products.product.add_to_cart' | t | default: 'Add to Cart' }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t | default: 'Sold Out' }}
                      {%- endif -%}
                    </button>
                    <foxy-wishlist-button 
                      class="foxy-pdp-wishlist-btn"
                      style="margin-left:8px;"
                      data-product-id="{{ product.id }}"
                      data-product-handle="{{ product.handle }}"
                      data-title="{{ product.title | escape }}"
                      data-price="{{ product.price | money | escape }}"
                      data-image="{{ product.featured_image | image_url: width: 400 }}"
                      data-url="{{ product.url }}"
                      data-variant-id="{{ product.variants.first.id }}">
                      <button aria-label="Add to wishlist" class="foxy-pdp__btn" style="padding:0; width:50px; border-radius:50%; min-width:auto;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                      </button>
                    </foxy-wishlist-button>
                  </div>
                  {%- if block.settings.show_dynamic_checkout -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                {%- endform -%}
             </div>
             
           {%- when 'buy_buttons' -%}
            <div {{ block.shopify_attributes }}>
              {% render 'foxy-product-meta-data',
                _labels: block.settings.foxy_md_labels,
                _allow_multiple: block.settings.foxy_md_allow_multiple,
                _start_open: block.settings.foxy_md_start_open,
                _layout: block.settings.foxy_md_layout,
                _content_placement: block.settings.foxy_md_content_placement,
                _icon: block.settings.foxy_md_icon,
                _pill_borders: block.settings.foxy_md_pill_bordered,
                _pill_internal_spacing: block.settings.foxy_md_pill_internal_spacing,
                _pill_external_spacing: block.settings.foxy_md_pill_external_spacing,
                _pill_rounded_borders: block.settings.foxy_md_pill_rounded_corners,
                _pill_bg_color: block.settings.foxy_md_pill_bgcolor,
                _pill_text_color: block.settings.foxy_md_pill_textcolor,
                _pill_border_color: block.settings.foxy_md_pill_bordercolor
              %}
            </div>
            
          {%- when 'custom_liquid' -%}
             <div {{ block.shopify_attributes }}>
                {{ block.settings.custom_liquid }}
             </div>

          {%- when 'related_products' -%}
            <div {{ block.shopify_attributes }}>
              {% render 'foxy-complimentary', block: block, product: product, section: section %}
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <!-- LIGHTBOX CONTAINER -->
  <div class="foxy-lightbox">
    <button class="foxy-lightbox__close" aria-label="Close Lightbox">&times;</button>
    <div class="foxy-lightbox__content">
      <img src="" width="1400" height="1400" loading="lazy" alt="Zoomed Product Image" class="foxy-lightbox__img">
    </div>
    {%- if product.media.size > 1 -%}
    <div class="foxy-lightbox__thumbnails">
      {%- for media in product.media -%}
        {%- if media.media_type == 'image' -%}
          <img src="{{ media | image_url: width: 200 }}" width="200" height="200" loading="lazy" data-full-src="{{ media | image_url: width: 1400 }}" class="foxy-lightbox__thumbnail" alt="Thumbnail {{ forloop.index }}">
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif -%}
    <div class="foxy-lightbox__controls">
      <span>Zoom Level:</span>
      <input type="range" class="foxy-lightbox__slider" min="1" max="5" step="0.1" value="1">
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Foxy Product Layout",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant Picker",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "default": true,
          "label": "Show dynamic checkout buttons"
        }
      ]
    },
    {
      "type": "metadata",
      "name": "Foxy Metadata Accordion",
      "settings": [
        {
          "type": "text",
          "id": "foxy_md_labels",
          "label": "Metadata Labels",
          "default": "Product Info, Allergy Information, Dietary Considerations, Delivery & Pickup"
        },
        {
          "type": "checkbox",
          "id": "foxy_md_allow_multiple",
          "label": "Allow multiple panels open",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "foxy_md_start_open",
          "label": "Start with panels open",
          "default": true
        },
        {
          "type": "select",
          "id": "foxy_md_layout",
          "label": "Layout",
          "options": [
             {"value": "vertical", "label": "Vertical"},
             {"value": "horizontal", "label": "Horizontal"}
          ],
          "default": "vertical"
        },
        {
          "type": "select",
          "id": "foxy_md_content_placement",
          "label": "Content Placement",
          "options": [
             {"value": "below", "label": "Below"},
             {"value": "side", "label": "Side"}
          ],
          "default": "below"
        },
        {
          "type": "text",
          "id": "foxy_md_icon",
          "label": "Dropdown Icon",
          "default": "chevron-down-outline"
        },
        {
          "type": "checkbox",
          "id": "foxy_md_pill_bordered",
          "label": "Pill Bordered",
          "default": true
        },
        {
          "type": "select",
          "id": "foxy_md_pill_internal_spacing",
          "label": "Internal Spacing",
          "options": [
             {"value": "small", "label": "Small"},
             {"value": "medium", "label": "Medium"}
          ],
          "default": "medium"
        },
        {
          "type": "select",
          "id": "foxy_md_pill_external_spacing",
          "label": "External Spacing",
          "options": [
             {"value": "small", "label": "Small"},
             {"value": "medium", "label": "Medium"}
          ],
          "default": "small"
        },
        {
          "type": "select",
          "id": "foxy_md_pill_rounded_corners",
          "label": "Rounded Corners",
          "options": [
             {"value": "small", "label": "Small"},
             {"value": "medium", "label": "Medium"}
          ],
          "default": "medium"
        },
        {
          "type": "color",
          "id": "foxy_md_pill_bgcolor",
          "label": "Pill Background Color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "foxy_md_pill_textcolor",
          "label": "Pill Text Color",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "foxy_md_pill_bordercolor",
          "label": "Pill Border Color",
          "default": "#000000"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid"
        }
      ]
    },
    {
      "type": "related_products",
      "name": "Related Products",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "You may also like",
          "label": "Heading"
        },
        {
          "type": "range",
          "id": "products_to_show",
          "min": 2,
          "max": 10,
          "step": 1,
          "default": 4,
          "label": "Products to show"
        },
        {
          "type": "range",
          "id": "columns_desktop",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 2,
          "label": "Columns on desktop"
        },
        {
          "type": "select",
          "id": "image_ratio",
          "options": [
            {"value": "adapt", "label": "Adapt to image"},
            {"value": "portrait", "label": "Portrait"},
            {"value": "square", "label": "Square"}
          ],
          "default": "adapt",
          "label": "Image ratio"
        },
        {
          "type": "checkbox",
          "id": "show_secondary_image",
          "default": true,
          "label": "Show second image on hover"
        },
        {
          "type": "checkbox",
          "id": "show_vendor",
          "default": false,
          "label": "Show vendor"
        },
        {
          "type": "checkbox",
          "id": "show_rating",
          "default": false,
          "label": "Show product rating"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Foxy Product Layout"
    }
  ]
}
{% endschema %}
