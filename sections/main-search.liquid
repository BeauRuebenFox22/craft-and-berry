{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}
{{ 'foxy-search.css' | asset_url | stylesheet_tag }}

<script src="{{ 'foxy-search.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<foxy-main-search data-section-id="{{ section.id }}">
  <div class="template-search section-{{ section.id }}-padding">
    
    <div class="foxy-search-header page-width">
      <h1 class="h2 center foxy-search-title">SEARCH OUR CELLAR</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="foxy-search-form">
        <div class="foxy-search-input-wrapper">
          <span class="svg-wrapper foxy-search-icon">
            {{- 'icon-search.svg' | inline_asset_content -}}
          </span>
          <input 
            type="search" 
            name="q"
            class="foxy-search-input" 
            placeholder="Search for Gins, Ales, Breweries, or Notes..."
            value="{{ search.terms | escape }}"
            autocomplete="off"
          >
          <div class="foxy-search-share-wrapper hidden">
            <button type="button" class="button button--tertiary foxy-search-share-btn">Share Results</button>
          </div>
        </div>
      </form>
    </div>

    {% comment %} Default Cellar View {% endcomment %}
    <div class="foxy-cellar-view page-width {% if search.performed and search.terms != blank %}hidden{% endif %}">
      
      {% comment %} FIND YOUR VIBE {% endcomment %}
      {% assign vibe_blocks = section.blocks | where: 'type', 'foxy_vibe_collection' %}
      {% if vibe_blocks.size > 0 %}
        <div class="foxy-cellar-section">
          <h2 class="foxy-cellar-heading">FIND YOUR VIBE</h2>
          <div class="foxy-vibe-grid">
            {% for block in vibe_blocks %}
              {% assign coll = collections[block.settings.collection] %}
              {% if coll != blank %}
                <a href="{{ coll.url }}" class="foxy-vibe-card" {{ block.shopify_attributes }}>
                  <div class="foxy-vibe-info">
                    <h3>{{ coll.title }}</h3>
                    <span class="foxy-vibe-btn">explore</span>
                  </div>
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 300 | image_tag: class: 'foxy-vibe-img', loading: 'lazy' }}
                  {% endif %}
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}

      <div class="foxy-cellar-heading foxy-cellar-heading--explore">OR EXPLORE BY...</div>

      <div class="foxy-cellar-bottom-stack">
        {% comment %} BEST SELLERS {% endcomment %}
        {% assign best_seller_block = section.blocks | where: 'type', 'foxy_best_seller' | first %}
        {% if best_seller_block %}
          <div class="foxy-cellar-section foxy-cellar-bestsellers" {{ best_seller_block.shopify_attributes }}>
            <h2 class="foxy-cellar-heading">BEST SELLERS</h2>
            <div class="foxy-bestsellers-container">
              <div class="foxy-loading-gif hidden">
                <svg width="40" height="40" viewBox="0 0 50 50" class="foxy-spinner"><circle cx="25" cy="25" r="20" fill="none" stroke="#7e3af2" stroke-width="4" stroke-dasharray="31.4 31.4" stroke-linecap="round"><animateTransform attributeName="transform" type="rotate" from="0 25 25" to="360 25 25" dur="1s" repeatCount="indefinite"/></circle></svg>
              </div>
              <div class="foxy-bestsellers-grid"></div>
            </div>
          </div>
        {% endif %}

        {% comment %} BREWERY OF THE WEEK {% endcomment %}
        {% assign brewery_block = section.blocks | where: 'type', 'foxy_brewery_of_week' | first %}
        {% if brewery_block %}
          <div class="foxy-cellar-section foxy-cellar-brewery" {{ brewery_block.shopify_attributes }}>
            <h2 class="foxy-cellar-heading">BREWERY OF THE WEEK</h2>
            <div class="foxy-brewery-card">
              <div class="foxy-brewery-content">
                <h3>{{ brewery_block.settings.title }}</h3>
                <p>{{ brewery_block.settings.text }}</p>
                {% if brewery_block.settings.link != blank %}
                  <a href="{{ brewery_block.settings.link }}" class="button button--primary foxy-brewery-btn">Shop the Collection</a>
                {% endif %}
              </div>
              <div class="foxy-brewery-images">
                {% if brewery_block.settings.logo_image != blank %}
                  {{ brewery_block.settings.logo_image | image_url: width: 200 | image_tag: class: 'foxy-brewery-logo' }}
                {% endif %}
                {% if brewery_block.settings.feature_image != blank %}
                  {{ brewery_block.settings.feature_image | image_url: width: 400 | image_tag: class: 'foxy-brewery-feature' }}
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    {% comment %} Search Results View {% endcomment %}
    <div class="foxy-search-results-view page-width {% unless search.performed and search.terms != blank %}hidden{% endunless %}">
      <div class="product-grid-container" id="ProductGridContainer">
        {%- if search.results.size == 0 and search.performed and search.terms != blank -%}
          <div class="foxy-search-results-grid foxy-search-empty" data-id="{{ section.id }}">
            <div class="title-wrapper center" style="text-align: center; width: 100%; padding: 4rem 0;">
              <h2 class="title title--primary" style="color: #fff;">
                {{ 'templates.search.no_results' | t: terms: search.terms }}
              </h2>
            </div>
          </div>
        {%- else -%}
          <div class="foxy-search-results-grid" data-id="{{ section.id }}">
            {%- for item in search.results -%}
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  <div class="foxy-product-card glass-panel text-center">
                    <a href="{{ item.url }}" class="foxy-card-image-wrapper">
                      {% if item.featured_image %}
                        {{ item.featured_image | image_url: width: 400 | image_tag: loading: 'lazy' }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      {% endif %}
                    </a>
                    <div class="foxy-card-details">
                      <h3 class="foxy-card-title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                      {% if item.metafields.custom.abv != blank or item.metafields.custom.volume != blank %}
                        <p class="foxy-card-meta">Stout | {{ item.metafields.custom.abv | default: '8.5%' }} ABV | {{ item.metafields.custom.volume | default: '12oz' }}</p>
                      {% endif %}
                      <p class="foxy-card-price">{{ item.price | money }}</p>
                      <div style="display: flex; gap: 8px;">
                        <form method="post" action="{{ routes.cart_add_url }}" data-product-form class="foxy-add-to-cart-form" style="flex:1;">
                          <input type="hidden" name="id" value="{{ item.variants.first.id }}">
                          <button type="submit" class="cyber-button w-full foxy-ajax-btn" {% unless item.available %}disabled style="opacity: 0.5; cursor: not-allowed;"{% endunless %}>
                            {% if item.available %}Add to Cart{% else %}Out of Stock{% endif %}
                          </button>
                        </form>
                        <foxy-wishlist-button 
                          data-product-id="{{ item.id }}"
                          data-product-handle="{{ item.handle }}"
                          data-title="{{ item.title | escape }}"
                          data-price="{{ item.price | money | escape }}"
                          data-image="{{ item.featured_image | image_url: width: 400 }}"
                          data-url="{{ item.url }}"
                          data-variant-id="{{ item.variants.first.id }}">
                          <button aria-label="Add to wishlist" class="foxy-pdp__btn foxy-pdp__wishlist-icon-btn" style="padding:0; width:50px; height:50px; border-radius:50%; min-width:auto; display:flex; align-items:center; justify-content:center;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                          </button>
                        </foxy-wishlist-button>
                      </div>
                    </div>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

  </div>
</foxy-main-search>

{% schema %}
{
  "name": "t:sections.main-search.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-search.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-search.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-search.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-search.settings.columns_mobile.options__2.label"
        }
      ]
    },    
    {
      "type": "header",
      "content": "t:sections.main-search.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-search.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-search.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-search.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.main-search.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.image_shape.options__1.label"
        },
        {
          "value": "arch",
          "label": "t:sections.all.image_shape.options__2.label"
        },
        {
          "value": "blob",
          "label": "t:sections.all.image_shape.options__3.label"
        },
        {
          "value": "chevronleft",
          "label": "t:sections.all.image_shape.options__4.label"
        },
        {
          "value": "chevronright",
          "label": "t:sections.all.image_shape.options__5.label"
        },
        {
          "value": "diamond",
          "label": "t:sections.all.image_shape.options__6.label"
        },
        {
          "value": "parallelogram",
          "label": "t:sections.all.image_shape.options__7.label"
        },
        {
          "value": "round",
          "label": "t:sections.all.image_shape.options__8.label"
        }
      ],
      "default": "default",
      "label": "t:sections.all.image_shape.label"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.main-search.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.main-search.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.main-search.settings.show_rating.label",
      "info": "t:sections.main-search.settings.show_rating.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "foxy_vibe_collection",
      "name": "Vibe Collection",
      "limit": 4,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        }
      ]
    },
    {
      "type": "foxy_best_seller",
      "name": "Best Sellers",
      "limit": 1,
      "settings": []
    },
    {
      "type": "foxy_brewery_of_week",
      "name": "Brewery of the Week",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Brewery Name"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo Image"
        },
        {
          "type": "image_picker",
          "id": "feature_image",
          "label": "Feature Image"
        }
      ]
    }
  ]
}
{% endschema %}
