<script src="{{ 'foxy-collection-layout.js' | asset_url }}" type="module" defer="defer"></script>
<script src="{{ 'foxy-collection-filters.js' | asset_url }}" type="module" defer="defer"></script>
<script src="{{ 'foxy-collection-grid.js' | asset_url }}" type="module" defer="defer"></script>
<script src="{{ 'foxy-abv-range.js' | asset_url }}" type="module" defer="defer"></script>

<foxy-collection-layout class="foxy-layout-container" id="FoxyCollectionLayout">
  
  <button type="button" class="foxy-mobile-filter-toggle hidden-desktop cyber-button">
    Filter & Sort
  </button>

  <div class="foxy-layout-left">
    <div class="foxy-filters-header hidden-desktop">
      <h3>Filters</h3>
      <button type="button" class="foxy-mobile-filter-close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <foxy-collection-filters>
      <form id="FoxyFacetFiltersForm">
        {%- if collection.current_vendor or collection.current_type -%}
          <input type="hidden" name="q" value="{{ collection.current_vendor }}{{ collection.current_type }}">
        {%- endif -%}

        <!-- Search Input fake facet / search params -->
        <div class="foxy-facet-search" style="margin-bottom: 12px;">
          <div class="search-input-wrapper">
            <svg viewBox="0 0 24 24" class="search-icon"><path fill="currentColor" d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
            <input type="text" name="q" placeholder="SEARCH OUR CELLAR" value="" class="foxy-search-bar" />
          </div>
        </div>
      </form>

      <form id="FoxyFacetFiltersForm" style="padding-top: 12px;">
        {%- if collection.current_vendor or collection.current_type -%}
          <input type="hidden" name="q" value="{{ collection.current_vendor }}{{ collection.current_type }}">
        {%- endif -%}

        {%- for filter in collection.filters -%}
          {%- assign filter_label_downcase = filter.label | downcase -%}
          {%- if filter_label_downcase == 'dietary preferences' or filter.param_name == 'filter.v.t.shopify.dietary-preferences' -%}
            <details class="foxy-facet-group" {% if forloop.first %}open{% endif %}>
              <summary class="foxy-facet-title">DIET</summary>
              <ul class="foxy-facet-list">
                {%- assign gf_value = nil -%}
                {%- assign veg_value = nil -%}
                {%- assign vegan_value = nil -%}
                
                {%- for value in filter.values -%}
                  {%- assign val_label_downcase = value.label | downcase -%}
                  {%- if val_label_downcase == 'gluten-free' or val_label_downcase == 'gluten free' -%}
                    {%- assign gf_value = value -%}
                  {%- elsif val_label_downcase == 'vegetarian' -%}
                    {%- assign veg_value = value -%}
                  {%- elsif val_label_downcase == 'vegan' -%}
                    {%- assign vegan_value = value -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- if gf_value -%}
                  <li class="foxy-facet-item">
                    <label class="foxy-checkbox-label">
                      <input type="checkbox"
                        name="{{ gf_value.param_name }}"
                        value="{{ gf_value.value }}"
                        {% if gf_value.active %}checked{% endif %}
                        {% if gf_value.count == 0 and gf_value.active == false %}disabled{% endif %}
                      >
                      <span class="foxy-checkbox-custom"></span>
                      <span class="foxy-checkbox-text">Gluten Free ({{ gf_value.count }})</span>
                    </label>
                  </li>
                {%- endif -%}

                {%- if veg_value -%}
                  <li class="foxy-facet-item">
                    <label class="foxy-checkbox-label">
                      <input type="checkbox"
                        name="{{ veg_value.param_name }}"
                        value="{{ veg_value.value }}"
                        {% if veg_value.active %}checked{% endif %}
                        {% if veg_value.count == 0 and veg_value.active == false %}disabled{% endif %}
                      >
                      <span class="foxy-checkbox-custom"></span>
                      <span class="foxy-checkbox-text">Vegetarian ({{ veg_value.count }})</span>
                    </label>
                  </li>
                {%- endif -%}

                {%- if vegan_value -%}
                  <li class="foxy-facet-item">
                    <label class="foxy-checkbox-label">
                      <input type="checkbox"
                        name="{{ vegan_value.param_name }}"
                        value="{{ vegan_value.value }}"
                        {% if vegan_value.active %}checked{% endif %}
                        {% if vegan_value.count == 0 and vegan_value.active == false %}disabled{% endif %}
                      >
                      <span class="foxy-checkbox-custom"></span>
                      <span class="foxy-checkbox-text">Vegan ({{ vegan_value.count }})</span>
                    </label>
                  </li>
                {%- endif -%}
              </ul>
            </details>
          {%- elsif filter_label_downcase == 'abv' -%}
            <details class="foxy-facet-group" {% if forloop.first %}open{% endif %}>
              <summary class="foxy-facet-title">ABV</summary>
              <foxy-abv-range>
                <div class="foxy-abv-slider-container" style="padding: 10px 0;">
                  <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                    <span class="foxy-abv-min-label">0%</span>
                    <span class="foxy-abv-max-label"></span>
                  </div>
                  <input type="range" class="foxy-abv-range-input" min="0" max="0" step="1" value="0" style="width: 100%;">
                </div>
                <ul class="foxy-facet-list foxy-abv-hidden-list" style="display: none;">
                  {%- for value in filter.values -%}
                    <li class="foxy-facet-item">
                      <label class="foxy-checkbox-label">
                        <input type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          data-numeric-value="{{ value.value }}"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %}
                        >
                      </label>
                    </li>
                  {%- endfor -%}
                </ul>
              </foxy-abv-range>
            </details>
          {%- else -%}
            <details class="foxy-facet-group" {% if forloop.first %}open{% endif %}>
              <summary class="foxy-facet-title">{{ filter.label | upcase }}</summary>
              
              {%- case filter.type -%}
                {%- when 'boolean' or 'list' -%}
                  <ul class="foxy-facet-list">
                    {%- for value in filter.values -%}
                      <li class="foxy-facet-item">
                        <label class="foxy-checkbox-label">
                          <input type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                            {% if value.count == 0 and value.active == false %}disabled{% endif %}
                          >
                          <span class="foxy-checkbox-custom"></span>
                          <span class="foxy-checkbox-text">{{ value.label | escape }} ({{ value.count }})</span>
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>

                {%- when 'price_range' -%}
                  <div class="foxy-price-range">
                    <div class="foxy-price-slider">
                      <input type="range" 
                        name="{{ filter.min_value.param_name }}"
                        min="0" 
                        max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                        step="1"
                        value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | replace: ',', '' }}{% else %}0{% endif %}"
                      >
                      <input type="range" 
                        name="{{ filter.max_value.param_name }}"
                        min="0" 
                        max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                        step="1"
                        value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | replace: ',', '' }}{% else %}{{ filter.range_max | money_without_currency | replace: ',', '' }}{% endif %}"
                      >
                    </div>
                    <div class="foxy-price-inputs">
                      <span>{{ cart.currency.symbol }}{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | replace: ',', '' }}{% else %}0{% endif %}</span>
                      <span>{{ cart.currency.symbol }}{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | replace: ',', '' }}{% else %}{{ filter.range_max | money_without_currency | replace: ',', '' }}{% endif %}</span>
                    </div>
                  </div>
              {%- endcase -%}
            </details>
          {%- endif -%}
        {%- endfor -%}
        
        <div class="foxy-mobile-apply hidden-desktop" style="margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--foxy-border);">
          <button type="button" class="cyber-button w-full foxy-mobile-filter-close">View Results</button>
        </div>
      </form>
    </foxy-collection-filters>
  </div>
  
  <div class="foxy-layout-right">
    <div class="foxy-grid-header">
      <div class="foxy-grid-controls hidden-mobile">
        <button type="button" data-cols="1" class="grid-layout-btn relative">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" stroke="currentColor" stroke-width="2"/></svg>
        </button>
        <button type="button" data-cols="2" class="grid-layout-btn relative">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="7" height="16" stroke="currentColor" stroke-width="2"/><rect x="14" y="4" width="7" height="16" stroke="currentColor" stroke-width="2"/></svg>
        </button>
        <button type="button" data-cols="3" class="grid-layout-btn relative active">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><rect x="2" y="4" width="5" height="16" stroke="currentColor" stroke-width="2"/><rect x="9.5" y="4" width="5" height="16" stroke="currentColor" stroke-width="2"/><rect x="17" y="4" width="5" height="16" stroke="currentColor" stroke-width="2"/></svg>
        </button>
      </div>
    </div>

    <foxy-collection-grid id="FoxyProductGridContainer" data-cols="3">
      {%- paginate collection.products by 12 -%}
        <div class="foxy-grid-wrapper foxy-custom-scrollbar" id="FoxyProductGrid">
          {%- if collection.products.size == 0 -%}
            <p class="foxy-no-products">No products found matching your filters.</p>
          {%- else -%}
            {%- for product in collection.products -%}
              <div class="foxy-product-card glass-panel text-center">
                <a href="{{ product.url }}" class="foxy-card-image-wrapper">
                  {% if product.featured_image %}
                    {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy' }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                </a>
                <div class="foxy-card-details">
                  <h3 class="foxy-card-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
                  {% if product.metafields.custom.abv != blank or product.metafields.custom.volume != blank %}
                    <p class="foxy-card-meta">Stout | {{ product.metafields.custom.abv | default: '8.5%' }} ABV | {{ product.metafields.custom.volume | default: '12oz' }}</p>
                  {% endif %}
                  <p class="foxy-card-price">{{ product.price | money }}</p>
                  <div style="display: flex; gap: 8px;">
                    <form method="post" action="{{ routes.cart_add_url }}" data-product-form class="foxy-add-to-cart-form" style="flex:1;">
                      <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                      <button type="submit" class="cyber-button w-full foxy-ajax-btn" {% unless product.available %}disabled style="opacity: 0.5; cursor: not-allowed;"{% endunless %}>
                        {% if product.available %}Add to Cart{% else %}Out of Stock{% endif %}
                      </button>
                    </form>
                    <foxy-wishlist-button 
                      data-product-id="{{ product.id }}"
                      data-product-handle="{{ product.handle }}"
                      data-title="{{ product.title | escape }}"
                      data-price="{{ product.price | money | escape }}"
                      data-image="{{ product.featured_image | image_url: width: 400 }}"
                      data-url="{{ product.url }}"
                      data-variant-id="{{ product.variants.first.id }}">
                      <button aria-label="Add to wishlist">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                      </button>
                    </foxy-wishlist-button>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <!-- We extract pagination data for the left panel to use -->
          <script id="FoxyPaginationData" type="application/json">
            {
              "previousUrl": {% if paginate.previous %}"{{ paginate.previous.url }}"{% else %}null{% endif %},
              "nextUrl": {% if paginate.next %}"{{ paginate.next.url }}"{% else %}null{% endif %}
            }
          </script>
        {%- endif -%}
      {%- endpaginate -%}
    </foxy-collection-grid>
    
    <div class="foxy-pagination-wrapper foxy-pagination-right">
      <!-- Will be populated via JS to align at bottom -->
    </div>
  </div>
</foxy-collection-layout>

{% schema %}
{
  "name": "Foxy Collection Main",
  "tag": "section",
  "class": "section foxy-collection-main-section",
  "settings": [],
  "presets": [
    {
      "name": "Foxy Collection Main"
    }
  ]
}
{% endschema %}
