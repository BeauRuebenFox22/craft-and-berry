    //     "image_ratio": "square",
    //     "show_secondary_image": true,
    //     "show_vendor": false,
    //     "show_rating": false
    //   }
    // },
    "related-products": {
      "type": "foxy-related-products",
      "settings": {
        "heading": "You may also like",
        "products_to_show": 4,
        "columns_desktop": 4,
        "image_ratio": "square",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false
      }
    }
  },
  "order": [
    "main",
