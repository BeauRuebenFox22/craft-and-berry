<div class="foxy-qty" data-variant-id="{{ variant.id }}" data-line-item-key="{{ line_item_key }}">
  <button type="button" class="foxy-qty__btn foxy-qty__btn--remove" aria-label="Remove item">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18m-2 0v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6m3 0V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2m-6 0h6"/></svg>
  </button>
  
  <button type="button" class="foxy-qty__btn foxy-qty__btn--minus" aria-label="Decrease quantity">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
  </button>
  
  <span class="foxy-qty__display">{{ value | default: 1 }}</span>
  
  <button type="button" class="foxy-qty__btn foxy-qty__btn--plus" aria-label="Increase quantity">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
  </button>
  
  <input type="hidden" name="quantity" class="foxy-qty__input" value="{{ value | default: 1 }}" min="0">
</div>

<style>
  .foxy-qty {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid #000;
    padding: 0.5rem 1rem;
    min-width: 140px;
    height: 48px;
    border-radius: 4px;
    background: #fff;
    box-sizing: border-box;
    user-select: none;
  }
  
  .foxy-qty__btn {
    background: none;
    border: none;
    padding: 0.25rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
    transition: opacity 0.2s;
  }
  
  .foxy-qty__btn:hover {
    opacity: 0.6;
  }
  
  .foxy-qty__btn--remove {
    margin-right: 0.5rem;
  }
  
  .foxy-qty__display {
    font-size: 1.1rem;
    font-weight: 500;
    min-width: 1.5rem;
    text-align: center;
  }
</style>

<script>
  (function() {
    if (window.foxyQtyInitialized) return;
    window.foxyQtyInitialized = true;

    document.addEventListener('click', function(e) {
      const btn = e.target.closest('.foxy-qty__btn');
      if (!btn) return;
      
      const container = btn.closest('.foxy-qty');
      if (!container) return;
      
      const input = container.querySelector('.foxy-qty__input');
      const display = container.querySelector('.foxy-qty__display');
      let val = parseInt(input.value);
      
      if (btn.classList.contains('foxy-qty__btn--plus')) {
        val++;
      } else if (btn.classList.contains('foxy-qty__btn--minus')) {
        if (val > 1) val--;
      } else if (btn.classList.contains('foxy-qty__btn--remove')) {
        val = 0;
        // If it's in the cart, we can call the cart update API here
        const lineKey = container.dataset.lineItemKey;
        if (lineKey) {
          updateCart(lineKey, 0);
        }
      }
      
      input.value = val;
      display.textContent = val;
      
      // Trigger change for any listeners
      input.dispatchEvent(new Event('change', { bubbles: true }));
      
      // If val is 0 and we are on PDP, maybe we reset it to 1 and just show a message?
      // For now, let's just let it be 0 if the user expects it to remove from cart.
    });
    
    async function updateCart(key, qty) {
      try {
        const response = await fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: key, quantity: qty })
        });
        const cart = await response.json();
        // Trigger cart update event (native dawn/shopify)
        if (window.pubsub) {
           publish(PUB_SUB_EVENTS.cartUpdate, { cartData: cart });
        } else {
           document.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
        }
      } catch (err) {
        console.error('Cart update failed', err);
      }
    }
  })();
</script>
